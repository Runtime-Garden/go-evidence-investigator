# Copy to .env and protect: chmod 600 .env
# Generate independent secrets with: openssl rand -hex 32
APP_AUTH_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARS
APP_REVIEW_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_64_HEX_CHARS
APP_REVIEWER_ID=authorized-reviewer
LISTEN_ADDR=:8080
DATA_DIR=/data/demo
CASE_DIR=/state

# OpenAI-compatible chat-completions API (direct HTTP JSON, no SDK)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# Provider must support strict JSON Schema (recommended); json_object still validates locally.
LLM_RESPONSE_FORMAT=json_schema

# Official TypeSafe endpoint (direct HTTP JSON, no SDK)
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_API_KEY=
